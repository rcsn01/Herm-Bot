# Build from the standalone repository root. Admit only the reproducible
# frontend and nginx inputs; local state, credentials, native artifacts, and
# node_modules never enter the Docker context.
**
!client/
!client/package.json
!client/package-lock.json
!client/index.html
!client/tsconfig.json
!client/vite.config.ts
!client/capacitor.config.ts
!client/src/
!client/src/**
!client/public/
!client/public/**
!client/vendor/
!client/vendor/**
!deploy/
!deploy/nginx.conf
!deploy/gateway.conf
!deploy/hermes-gateway.sh
!deploy/docker-entrypoint.sh
