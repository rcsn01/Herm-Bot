# Hermes HTTP backend reachable FROM THE CONTAINER (not from the browser).
# host:port, hostname, or http://host:port. Default: host.docker.internal:8642
# HERMES_GATEWAY=host.docker.internal:8642
# HERMES_URL=http://192.168.1.10:9119

# Optional host port for the PWA. Defaults to 8080.
# HERMES_MOBILE_PORT=8080

# Public HTTPS origin where the PWA is installed.
WEBPUSH_PWA_URL=https://mobile.example

# Optional VAPID contact identifier. Defaults to WEBPUSH_PWA_URL; do not use
# an @localhost address because Apple Web Push rejects it.
# HERMES_WEB_PUSH_SUBJECT=mailto:you@example.com

# The completion bridge observes the existing Hermes Gateway API. Use either
# an existing static Hermes token or the existing dashboard password login.
# It does not install a plugin, hook, delivery channel, or credential in Hermes.
HERMES_COMPLETION_BRIDGE_ENABLED=true
# HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_USERNAME=
HERMES_BRIDGE_PASSWORD=
# HERMES_BRIDGE_AUTH_PROVIDER=password
# HERMES_BRIDGE_POLL_INTERVAL_MS=1000
