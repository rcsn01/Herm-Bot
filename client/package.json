{
  "name": "@hermes/mobile-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "cap:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:live": "node scripts/ios-live.mjs",
    "ios:test": "swift test --package-path ios/App && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 17 Pro' CODE_SIGNING_ALLOWED=NO build",
    "ipa": "node scripts/build-ipa.mjs"
  },
  "dependencies": {
    "@capacitor/app": ">=8.0.0 <9",
    "@capacitor/core": ">=8.0.0 <9",
    "@capacitor/haptics": ">=8.0.0 <9",
    "@capacitor/ios": ">=8.0.0 <9",
    "@capacitor/preferences": ">=8.0.0 <9",
    "@hermes/shared": "file:../../shared",
    "@nanostores/react": ">=1.1.0 <2",
    "@tabler/icons-react": ">=3.41.1 <4",
    "@tanstack/react-query": ">=5.101.2 <6",
    "class-variance-authority": ">=0.7.1 <0.9",
    "clsx": ">=2.1.1 <3",
    "nanostores": ">=1.3.0 <2",
    "radix-ui": ">=1.4.3 <2",
    "react": ">=19.2.5 <20",
    "react-dom": ">=19.2.5 <20",
    "react-markdown": ">=10.1.0 <11",
    "remark-gfm": ">=4.0.1 <5",
    "tailwind-merge": ">=3.5.0 <4"
  },
  "devDependencies": {
    "@capacitor/cli": ">=8.0.0 <9",
    "@tailwindcss/vite": ">=4.2.4 <5",
    "@testing-library/react": ">=16.3.2 <17",
    "@types/node": ">=22.20.0 <23",
    "@types/react": ">=19.2.14 <20",
    "@types/react-dom": ">=19.2.3 <20",
    "@vitejs/plugin-react": ">=6.0.1 <7",
    "jsdom": ">=29.0.0 <30",
    "tailwindcss": ">=4.2.4 <5",
    "typescript": ">=6.0.3 <7",
    "vite": ">=8.0.10 <9",
    "vitest": ">=4.1.5 <5"
  }
}
